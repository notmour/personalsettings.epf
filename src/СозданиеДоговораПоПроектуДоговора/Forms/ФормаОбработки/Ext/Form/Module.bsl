#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьДоговор(Команда)

	Если Не ЗначениеЗаполнено(ПроектДоговора) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выберите проект договора");
		Возврат;
	КонецЕсли;

	Результат = СоздатьДоговорНаСервере(ПроектДоговора);

	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя("Готово", , "Создан договор: " + Строка(Результат.Договор));
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СоздатьДоговорНаСервере(Знач Ссылка)

	Результат = Новый Структура("Успех, Договор, ТекстОшибки", Ложь, Неопределено, "");

	// проверяем, нет ли уже связанного договора, чтобы не наплодить дублей
	СуществующийДоговор = бит_Договоры.ДоговорКонтрагентаПоПроектуДоговора(Ссылка);
	Если ЗначениеЗаполнено(СуществующийДоговор) Тогда
		Результат.ТекстОшибки = "У проекта уже есть договор: " + Строка(СуществующийДоговор);
		Возврат Результат;
	КонецЕсли;

	// Если хочешь сохранить бизнес-проверку на утвержденный график, раскомментируй.
	// Смотри точные условия в модуле формы бит_ПроектДоговора, процедура прм_СоздатьДоговорСервер1.
	//Если Документы.бит_ПроектДоговора.СК_ДляПроектаДоговораПроверяютсяДополнительныеУсловия(Ссылка) Тогда
	//	Если Не Документы.бит_ПроектДоговора.СК_ДопУсловиеУтвержден(Ссылка) Тогда
	//		Результат.ТекстОшибки = "Нет утвержденного графика";
	//		Возврат Результат;
	//	КонецЕсли;
	//КонецЕсли;

	НачатьТранзакцию();
	Попытка

		СозданныйДоговор = бит_Договоры.СоздатьДоговорНаОснованииПроекта(Ссылка);

		Если СозданныйДоговор = Неопределено Тогда
			Результат.ТекстОшибки = "Метод СоздатьДоговорНаОснованииПроекта вернул Неопределено, договор не создан";
			ОтменитьТранзакцию();
			Возврат Результат;
		КонецЕсли;

		бит_Договоры.ОбновитьДоговорВДокументахДопУсловияПоДоговору(СозданныйДоговор, Ссылка, "Все");

		ЗафиксироватьТранзакцию();

		Результат.Успех = Истина;
		Результат.Договор = СозданныйДоговор;

	Исключение
		ОтменитьТранзакцию();
		Результат.ТекстОшибки = "Ошибка при создании договора: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти